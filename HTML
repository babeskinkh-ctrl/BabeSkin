<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Babe Skin</title>
  <style>
    :root{
      --pink: #e9a3b4;
      --pink-dark: #c8708c;
      --pink-soft: #fff1f5;
      --text: #2d1c22;
      --muted: #70525d;
      --white: #ffffff;
      --border: #f3d9e2;
      --shadow: 0 10px 24px rgba(196, 112, 140, 0.15);
    }

    *{ box-sizing: border-box; }
    html{ scroll-behavior: smooth; }
    body{
      margin:0;
      font-family: Arial, sans-serif;
      background: linear-gradient(180deg, #fffdfd 0%, #fff3f7 100%);
      color: var(--text);
    }

    a{ text-decoration:none; color:inherit; }
    img{ max-width:100%; display:block; }
    button, input, textarea, select{
      font: inherit;
    }

    .container{
      width:min(1100px, calc(100% - 30px));
      margin:0 auto;
    }

    header{
      position:sticky;
      top:0;
      z-index:10;
      background: rgba(255,255,255,0.9);
      backdrop-filter: blur(10px);
      border-bottom:1px solid rgba(233,163,180,0.18);
    }

    .nav{
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:18px 0;
      gap:20px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:12px;
      font-weight:700;
      font-size:1.2rem;
    }

    .logo{
      width:42px; height:42px;
      border-radius:50%;
      background: linear-gradient(135deg, var(--pink) 0%, var(--pink-dark) 100%);
      display:grid; place-items:center;
      color:white;
      box-shadow: var(--shadow);
    }

    .menu{
      display:flex;
      gap:20px;
      color: var(--muted);
      font-size:0.95rem;
    }

    .menu a:hover{ color: var(--pink-dark); }

    .nav-actions{
      display:flex;
      gap:10px;
      align-items:center;
      flex-wrap: wrap;
    }

    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      border:none;
      border-radius:999px;
      padding:12px 18px;
      font-weight:700;
      cursor:pointer;
      transition:0.2s ease;
    }

    .btn-primary{
      background: linear-gradient(135deg, var(--pink) 0%, var(--pink-dark) 100%);
      color: #fff;
      box-shadow: var(--shadow);
    }

    .btn-secondary{
      background:#fff;
      color: var(--pink-dark);
      border:1px solid rgba(200,112,140,0.15);
    }

    .btn:hover{
      transform: translateY(-1px);
    }

    .hero{
      padding:35px 0 20px;
    }

    .hero-box{
      display:grid;
      grid-template-columns:1.2fr 0.8fr;
      gap:25px;
      background: linear-gradient(135deg, #fffafc 0%, #fff2f6 100%);
      border:1px solid rgba(233,163,180,0.2);
      border-radius:28px;
      box-shadow: var(--shadow);
      padding:28px;
    }

    .eyebrow{
      display:inline-block;
      background:#fff;
      color: var(--pink-dark);
      border:1px solid rgba(200,112,140,0.12);
      border-radius:999px;
      padding:8px 14px;
      font-size:0.75rem;
      letter-spacing:0.08em;
      text-transform:uppercase;
      font-weight:700;
      margin-bottom:12px;
    }

    h1{
      font-size: clamp(2.3rem, 4vw, 4rem);
      line-height:1.1;
      margin:0 0 16px;
    }

    .hero p{
      color: var(--muted);
      font-size:1.05rem;
      line-height:1.7;
      margin:0 0 24px;
      max-width: 600px;
    }

    .hero-actions{
      display:flex;
      gap:14px;
      flex-wrap:wrap;
      margin-bottom:20px;
    }

    .stats{
      display:flex;
      gap:26px;
      flex-wrap:wrap;
    }

    .stat strong{
      display:block;
      font-size:1.7rem;
      margin-bottom:4px;
    }

    .stat span{
      color: var(--muted);
      font-size:0.9rem;
    }

    .showcase{
      background: rgba(255,255,255,0.75);
      border:1px solid rgba(200,112,140,0.15);
      border-radius:24px;
      box-shadow: var(--shadow);
      padding:18px;
      transform: rotate(4deg);
      min-height: 300px;
    }

    .showcase-visual{
      height:270px;
      border-radius:18px;
      background: linear-gradient(135deg, #f9dfe8 0%, #f6e8e3 100%);
      position:relative;
      display:grid;
      place-items:center;
      overflow:hidden;
    }

    .showcase-visual::before{
      content:"";
      position:absolute;
      width:120px; height:120px;
      border-radius:50%;
      background: rgba(255,255,255,0.3);
      top:-24px; right:-20px;
    }

    .bottle{
      width:120px; height:180px;
      background: linear-gradient(180deg, #fff 0%, #f8dfeb 100%);
      border:3px solid rgba(200,112,140,0.18);
      border-radius:22px 22px 28px 28px;
      position:relative;
      box-shadow:0 18px 25px rgba(200,112,140,0.18);
    }

    .bottle::before{
      content:"";
      position:absolute;
      width:70%; height:18px;
      left:15%; top:-18px;
      border-radius:8px 8px 4px 4px;
      background: linear-gradient(180deg, #d998ac, #c76d8d);
    }

    .bottle::after{
      content:"";
      position:absolute;
      width:60%; height:28px;
      left:20%; top:38px;
      border-radius:12px;
      background: linear-gradient(180deg, #ffd7b5, #f0b17d);
      box-shadow: inset 0 0 0 4px rgba(255,255,255,0.5);
    }

    .showcase-info{
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin-top:16px;
      gap:10px;
    }

    .showcase-info h3{
      margin:0;
      font-size:1.2rem;
    }

    .showcase-info p{
      margin:4px 0 0;
      color: var(--muted);
      font-size:0.9rem;
    }

    .price{
      background:#fff3f6;
      border:1px solid rgba(200,112,140,0.12);
      color: var(--pink-dark);
      font-weight:700;
      padding:10px 12px;
      border-radius:12px;
      white-space:nowrap;
    }

    .section{
      padding:34px 0;
    }

    .section-head{
      display:flex;
      justify-content:space-between;
      align-items:flex-end;
      gap:16px;
      margin-bottom:20px;
    }

    .section-head h2{
      margin:0;
      font-size: clamp(1.8rem, 3vw, 2.7rem);
    }

    .section-head p{
      margin:8px 0 0;
      color: var(--muted);
    }

    .mini-link{
      background:#fff;
      color: var(--pink-dark);
      border:1px solid rgba(200,112,140,0.15);
      border-radius:999px;
      padding:10px 14px;
      font-weight:700;
      box-shadow: var(--shadow);
    }

    .product-grid{
      display:grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap:24px;
    }

    .product-card{
      background:#fff;
      border:1px solid rgba(200,112,140,0.12);
      border-radius:18px;
      overflow:hidden;
      box-shadow: var(--shadow);
      transition:transform 0.2s ease;
    }

    .product-card:hover{
      transform:translateY(-4px);
    }

    .card-image{
      height:220px;
      background: linear-gradient(135deg, #fbe7ee 0%, #f7e6e1 100%);
      display:grid;
      place-items:center;
      position:relative;
      overflow:hidden;
    }

    .card-image::before{
      content:"";
      position:absolute;
      width:140px; height:140px;
      right:-20px; top:-30px;
      border-radius:50%;
      background: rgba(255,255,255,0.3);
    }

    .jar{
      width:110px; height:120px;
      background: linear-gradient(180deg, #fff 0%, #f9ebf0 100%);
      border:3px solid rgba(200,112,140,0.18);
      border-radius:26px 26px 30px 30px;
      position:relative;
      box-shadow:0 18px 22px rgba(200,112,140,0.15);
    }

    .jar::before{
      content:"";
      position:absolute;
      width:54%; height:18px;
      left:23%; top:-18px;
      border-radius:10px 10px 3px 3px;
      background: linear-gradient(180deg, #d698ab, #c96f8d);
    }

    .jar::after{
      content:"";
      position:absolute;
      width:46%; height:38px;
      left:27%; top:34px;
      border-radius:12px;
      background: linear-gradient(180deg, #f6d5b4, #f0b584);
      box-shadow: inset 0 0 0 4px rgba(255,255,255,0.45);
    }

    .card-body{
      padding:18px;
    }

    .card-top{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:10px;
      margin-bottom:10px;
    }

    .category{
      background:#f9edf1;
      color: var(--pink-dark);
      font-weight:700;
      font-size:0.7rem;
      letter-spacing:0.08em;
      text-transform:uppercase;
      padding:7px 9px;
      border-radius: 999px;
    }

    .product-price{
      color: var(--pink-dark);
      font-size:1.2rem;
      font-weight:800;
    }

    .card-body h3{
      margin:0 0 10px;
      font-size:1.3rem;
    }

    .card-body p{
      margin:0 0 18px;
      color: var(--muted);
      line-height:1.6;
      min-height: 76px;
    }

    .card-actions{
      display:flex;
      gap:10px;
    }

    .small-btn{
      flex:1;
      padding:10px 12px;
      border:none;
      border-radius:12px;
      cursor:pointer;
      font-weight:700;
    }

    .buy-btn{
      background: linear-gradient(135deg, var(--pink) 0%, var(--pink-dark) 100%);
      color:white;
    }

    .edit-btn{
      background:#fffafc;
      color: var(--pink-dark);
      border:1px solid rgba(200,112,140,0.12);
    }

    .form-wrap{
      background: linear-gradient(180deg, #fffdfd 0%, #fff4f7 100%);
      border:1px solid rgba(200,112,140,0.12);
      border-radius:24px;
      box-shadow: var(--shadow);
      padding:24px;
    }

    .form-grid{
      display:grid;
      grid-template-columns:repeat(2, minmax(0, 1fr));
      gap:18px;
    }

    .field{
      display:flex;
      flex-direction:column;
      gap:8px;
      font-weight:600;
    }

    .field input, .field textarea, .field select{
      width:100%;
      border:1px solid rgba(200,112,140,0.2);
      border-radius:12px;
      padding:13px 14px;
      background:#fff;
      outline:none;
      transition:box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .field input:focus, .field textarea:focus, .field select:focus{
      border-color: var(--pink-dark);
      box-shadow:0 0 0 4px rgba(233,163,180,0.12);
    }

    .field textarea{
      min-height:120px;
      resize:vertical;
    }

    .form-actions{
      display:flex;
      flex-wrap:wrap;
      align-items:center;
      gap:12px;
      margin-top:20px;
    }

    .note{
      color: var(--muted);
      font-size:0.9rem;
    }

    footer{
      padding:28px 0 40px;
      text-align:center;
      color: var(--muted);
      font-size:0.95rem;
    }

    @media (max-width: 900px){
      .hero-box{
        grid-template-columns:1fr;
      }
      .product-grid{
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .menu{
        display:none;
      }
    }

    @media (max-width: 620px){
      .nav{
        flex-wrap:wrap;
      }
      .nav-actions{
        width:100%;
        justify-content:space-between;
      }
      .hero-actions{
        flex-direction:column;
      }
      .hero-actions .btn{
        width:100%;
      }
      .product-grid, .form-grid{
        grid-template-columns:1fr;
      }
      .section-head{
        flex-direction:column;
        align-items:flex-start;
      }
    }
  </style>
</head>
<body>
  <header>
    <div class="container nav">
      <div class="brand">
        <div class="logo">B</div>
        <div>Babe Skin</div>
      </div>

      <nav class="menu">
        <a href="#home">Home</a>
        <a href="#products">Products</a>
        <a href="#catalog">Catalog</a>
        <a href="#add-product">Add Product</a>
        <a href="#contact">Contact</a>
      </nav>

      <div class="nav-actions">
        <a class="btn btn-secondary" href="https://t.me/your_telegram_bot" target="_blank">Telegram Mini App</a>
        <a class="btn btn-primary" href="#products">Shop Now</a>
      </div>
    </div>
  </header>

  <main id="home">
    <section class="hero">
      <div class="container hero-box">
        <div>
          <div class="eyebrow">Glow & Care</div>
          <h1>Healthy skin begins with Babe Skin.</h1>
          <p>We provide the best skincare products. Discover skincare essentials designed to cleanse, nourish, brighten, and protect your skin every day.</p>

          <div class="hero-actions">
            <a class="btn btn-primary" href="#products">Browse Products</a>
            <a class="btn btn-secondary" href="https://t.me/your_telegram_bot" target="_blank">Open Mini App</a>
          </div>

          <div class="stats">
            <div class="stat">
              <strong>12k+</strong>
              <span>Happy users</span>
            </div>
            <div class="stat">
              <strong>98%</strong>
              <span>Skin satisfaction</span>
            </div>
            <div class="stat">
              <strong>4.9/5</strong>
              <span>Customer review</span>
            </div>
          </div>
        </div>